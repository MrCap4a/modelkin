# Nginx server block for Modelkin.рф — for a server that already hosts
# another site behind its own nginx. Adds a new vhost alongside the
# existing one(s); does not touch them. See DEPLOYMENT.md for the full
# walkthrough.
#
# 1. Replace `modelkin.ru` (both `server_name` entries) with your real
#    domain, and `3000` in `proxy_pass` with your APP_HOST_PORT from .env
#    if you changed it from the default.
# 2. Copy this file to /etc/nginx/sites-available/modelkin.conf
#    (Debian/Ubuntu path — RHEL-family distros use /etc/nginx/conf.d/
#    instead and don't need the symlink step below).
# 3. ln -s /etc/nginx/sites-available/modelkin.conf /etc/nginx/sites-enabled/
# 4. nginx -t && systemctl reload nginx
# 5. certbot --nginx -d modelkin.ru -d www.modelkin.ru
#    Certbot rewrites this file in place to add the HTTPS server block, the
#    HTTP->HTTPS redirect, and a renewal timer — don't hand-edit the parts
#    it adds afterward. Re-running `certbot renew` (already on a systemd
#    timer/cron after install) keeps the cert current; nothing else to do.

server {
    listen 80;
    listen [::]:80;
    server_name modelkin.ru www.modelkin.ru;

    # Server Actions cap request bodies at 2mb (next.config.ts) — actual
    # file uploads (STL/images) go straight from the browser to S3 via
    # presigned URLs and never pass through here, so this only needs to
    # comfortably clear that 2mb ceiling.
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
