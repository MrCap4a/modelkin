# Copy this file to .env (local dev) and fill in real values.
# See DEPLOYMENT.md for production configuration guidance.

NODE_ENV=development

# Public base URL of the application (used to build absolute links in emails,
# for CSP frame-ancestors/img-src, and for cookie configuration).
APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# If port 5432 is already used by another local Postgres install, set
# POSTGRES_HOST_PORT (used by docker-compose.yml) and update the port below
# to match.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql://modelkin:modelkin@localhost:5432/modelkin?schema=public

# --- Object storage (S3-compatible; MinIO for local dev) ----------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=modelkin
S3_SECRET_ACCESS_KEY=modelkin-secret
S3_BUCKET=modelkin
# true for MinIO / most self-hosted S3-compatible services
S3_FORCE_PATH_STYLE=true
# Public host used for <Image> remotePatterns and CSP img-src. Only needed
# when files are served through a public URL/CDN rather than always via
# signed URLs.
S3_PUBLIC_HOST_FOR_CSP=http://localhost:9000

# --- Email ----------------------------------------------------------------
# "console" writes emails to the application log instead of sending them —
# safe default for local development. See src/infrastructure/email.
MAIL_PROVIDER=console
MAIL_FROM=no-reply@modelkin.ru

# --- Commerce ---------------------------------------------------------------
# Platform commission taken from author sales, in basis points (2000 = 20%).
PLATFORM_COMMISSION_BPS=2000

# --- Logging ----------------------------------------------------------------
LOG_DIR=logs
LOG_LEVEL=info
